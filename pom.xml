<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.cloud</groupId>
    <artifactId>ops-server</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <description>Linux运维管理系统</description>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.13</version>
        <relativePath/>
    </parent>

    <modules>
        <module>ops-common</module>
        <module>ops-admin</module>
        <module>ops-receiver</module>
    </modules>

    <properties>

        <spring.boot.version>3.1.0</spring.boot.version>

        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>

        <hutool.version>5.8.15</hutool.version>

        <mysql.version>8.0.28</mysql.version>
        <druid.version>1.2.16</druid.version>
        <mybatis-plus.version>3.5.7</mybatis-plus.version>

        <knife4j.version>4.3.0</knife4j.version>
        <!--
            覆盖 knife4j 4.3.0 传递引入的 springdoc-openapi 2.2.0：
            2.2.0 的 GenericResponseService 调用的 ControllerAdviceBean(Object) 构造器
            已在 Spring Framework 6.2（Spring Boot 3.5）中移除，
            运行时抛 NoSuchMethodError，必须升级到 2.8.x。
        -->
        <springdoc.version>2.8.9</springdoc.version>

        <mapstruct.version>1.5.3.Final</mapstruct.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>

        <xxl-job.version>2.5.0</xxl-job.version>

        <jjwt.version>0.11.5</jjwt.version>

        <easyexcel.version>3.2.1</easyexcel.version>

        <!-- 验证码 -->
        <easy-captcha.version>1.6.2</easy-captcha.version>
        <nashorn.version>15.4</nashorn.version>

        <!-- redisson 分布式锁 -->
        <redisson.version>3.21.0</redisson.version>



        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <fastjson.version>2.0.53</fastjson.version>

        <!-- 代码混淆（ProGuard）：默认在 package 阶段执行，可用 -Dproguard.skip=true 跳过 -->
        <proguard.skip>true</proguard.skip>
        <proguard-plugin.version>2.6.0</proguard-plugin.version>
        <proguard.version>7.5.0</proguard.version>
        <!-- 必须与 proguard-base 匹配的 proguard-core 版本（proguard-base 7.5.0 对应 core 9.1.4） -->
        <proguard.core.version>9.1.4</proguard.core.version>
        <!--
            Spring Cloud Alibaba（Nacos 配置中心）：
            2025.0.0.0 对应 Spring Boot 3.5.x / Spring Cloud 2025.0.x。
            其依赖的 nacos-client 内部已兼容 snakeyaml 2.x，
            与旧版 nacos-config-spring-boot-starter 的冲突问题不存在。
        -->
        <spring-cloud-alibaba.version>2025.0.0.0</spring-cloud-alibaba.version>
        <nacos-config-spring-boot.version>0.3.0-RC</nacos-config-spring-boot.version>
        <!--
            切勿在此覆盖 snakeyaml 版本（尤其不要降到 1.x）：
            Spring Boot 3.5 的 YamlPropertySourceLoader 依赖 snakeyaml 2.x 才有的
            org.yaml.snakeyaml.inspector.TagInspector，若把 snakeyaml.version 固定为 1.33，
            连 application.yml 都无法解析，启动即抛：
              java.lang.NoClassDefFoundError: org/yaml/snakeyaml/inspector/TagInspector
            保持 Spring Boot 父 POM 默认版本（2.4）即可；
            需要 1.x snakeyaml 的 nacos-config-spring-boot-starter 已在 ops-receiver/pom.xml 中停用。
        -->
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
                Spring Cloud Alibaba BOM：管理 Nacos 相关 starter 版本。
                该 BOM 内部已 import 对应版本的 spring-cloud-dependencies，
                无需再单独引入 spring-cloud-dependencies。
            -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!--
                钉住 nacos-client 版本（必须显式声明，优先级高于上方 BOM 的 import）：
                spring-cloud-alibaba 2025.0.0.0 默认传递 nacos-client 3.0.3，
                而 3.x 客户端与本项目使用的 Nacos Server 2.3.2 gRPC 协议不兼容——
                连接可建立（9848 端口正常、HTTP/2 握手正常），但配置查询静默返回 null，
                应用启动时表现为 [Nacos Config] config[dataId=xxx] is empty。
                实测 nacos-client 2.4.3 + Server 2.3.2 可正常拉取配置。
                若日后升级 Nacos Server 到 3.x，可移除此钉版。
            -->
            <dependency>
                <groupId>com.alibaba.nacos</groupId>
                <artifactId>nacos-client</artifactId>
                <version>2.4.3</version>
            </dependency>
            <!--
                管理传递依赖版本：knife4j 4.3.0 自带的 springdoc-openapi-starter-webmvc-ui:2.2.0
                与 Spring Framework 6.2（Boot 3.5）二进制不兼容，统一仲裁到 2.8.9。
                仅钉住此顶层 artifact 即可，其下游 springdoc-openapi-starter-webmvc-api /
                springdoc-openapi-starter-common 等会随之按 2.8.9 解析。
            -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>

    </dependencies>

</project>
