    <build>
        <finalName>bs-monitor</finalName>
        <plugins>
            <!--
                ============================================================
                代码混淆（ProGuard），防止 jar 被轻易反编译
                ============================================================
                策略：保留类名 / 字段名 / 接口方法与序列化(getter,setter)方法名，
                      仅混淆其余方法实现，并对方法体做名称混淆、去除源文件名等处理。
                原因：本项目大量依赖“名字”的隐式约定：
                  * MyBatis XML 中 resultType/namespace 使用全限定类名
                  * Class.forName(mappedStatementId) 反射 Mapper 类及其注解
                  * SpEL bean 名：@ss.hasPerm(...) / #{monitorCmdDirectQueue.name}
                  * @Resource 默认按字段名注入，@Bean 方法名即 bean 名
                  * @SelectProvider(type=..., 无 method) 依赖与被注解方法同名的方法
                跳过混淆：mvn package -Dproguard.skip=true
                ============================================================
            -->
            <plugin>
                <groupId>com.github.wvengen</groupId>
                <artifactId>proguard-maven-plugin</artifactId>
                <version>${proguard-plugin.version}</version>
                <dependencies>
                    <!--
                        插件自带的 proguard-base / proguard-core 均为 optional 依赖，
                        Maven 不会把它们放进插件的运行时 classpath，因此必须在此显式声明，
                        否则报 "proguard jar not found in pluginArtifacts" /
                        "Obfuscation failed ProGuard (proguard.ProGuard) not found in classpath"。

                        注意 1：proguard-core 必须显式声明，且版本要和 proguard-base 严格匹配。
                                只声明 proguard-base 时，其传递依赖 core 9.1.4 会被插件自身声明的
                                core 9.0.1 覆盖（同 groupId/artifactId 仲裁取更浅的依赖），
                                于是 realm 里变成 base 7.5.0 + core 9.0.1 的二进制不兼容组合，
                                表现为 fork 出的 JVM 立即以退出码 1 结束：
                                "Obfuscation failed (result=1)"，且不产生任何输入输出文件。
                        注意 2：不要再配置 <proguardVersion>，该参数会按版本号严格过滤，
                                会把版本号不同的 proguard-core 一并排除掉。
                    -->
                    <dependency>
                        <groupId>com.guardsquare</groupId>
                        <artifactId>proguard-base</artifactId>
                        <version>${proguard.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>com.guardsquare</groupId>
                        <artifactId>proguard-core</artifactId>
                        <version>${proguard.core.version}</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>proguard-obfuscate</id>
                        <!-- 编译完成后立即混淆 target/classes，保证后续 jar / spring-boot repackage 打包的是混淆后的 class -->
                        <phase>process-classes</phase>
                        <goals>
                            <goal>proguard</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <skip>${proguard.skip}</skip>
                    <obfuscate>true</obfuscate>
                    <!-- Windows 下依赖较多，改为通过临时配置文件传参，规避命令行长度限制 -->
                    <generateTemporaryConfigurationFile>true</generateTemporaryConfigurationFile>
                    <!-- 处理并原地覆盖 target/classes -->
                    <injar>classes</injar>
                    <outjar>classes</outjar>
                    <outputDirectory>${project.build.directory}</outputDirectory>
                    <libs>
                        <lib>${java.home}/jmods/java.base.jmod</lib>
                        <lib>${java.home}/jmods/java.logging.jmod</lib>
                        <lib>${java.home}/jmods/java.xml.jmod</lib>
                        <lib>${java.home}/jmods/java.sql.jmod</lib>
                        <lib>${java.home}/jmods/java.naming.jmod</lib>
                        <lib>${java.home}/jmods/java.management.jmod</lib>
                        <lib>${java.home}/jmods/java.desktop.jmod</lib>
                        <lib>${java.home}/jmods/java.instrument.jmod</lib>
                        <lib>${java.home}/jmods/java.net.http.jmod</lib>
                        <lib>${java.home}/jmods/jdk.unsupported.jmod</lib>
                    </libs>
                    <options>
                        <!-- 基础：这里只做名称混淆，不做裁剪/优化，避免反射与注解驱动的代码被误删 -->
                        <option>-ignorewarnings</option>
                        <option>-dontnote</option>
                        <option>-dontwarn</option>
                        <option>-dontshrink</option>
                        <option>-dontoptimize</option>
                        <option>-dontusemixedcaseclassnames</option>
                        <!-- 保留注解、泛型签名、内部类等信息（Spring/MyBatis/Jackson 强依赖注解） -->
                        <option>-keepattributes Exceptions,InnerClasses,Signature,Deprecated,SourceFile,LineNumberTable,EnclosingMethod,AnnotationDefault</option>
                        <option>-keepattributes *Annotation*</option>
                        <option>-keepattributes RuntimeVisibleAnnotations,RuntimeInvisibleAnnotations,RuntimeVisibleParameterAnnotations,RuntimeInvisibleParameterAnnotations,RuntimeVisibleTypeAnnotations,RuntimeInvisibleTypeAnnotations</option>
                        <!-- 去掉源文件名，进一步增加反编译阅读成本 -->
                        <option>-renamesourcefileattribute SourceFile</option>

                        <!-- 应用入口 -->
                        <option>-keep public class com.bszn.SystemApplication { public static void main(java.lang.String[]); }</option>

                        <!-- 1) 保留类名：MyBatis XML 全限定名、Class.forName、SpEL/bean 名等均强绑定类名 -->
                        <option>-keepnames class com.bszn.**</option>

                        <!-- 2) 保留接口全部成员：Mapper 接口方法名与 XML id / @SelectProvider 同名约定 -->
                        <option>-keep interface com.bszn.** { *; }</option>

                        <!-- 3) 保留枚举（含 values/valueOf） -->
                        <option>-keep enum com.bszn.** { *; }</option>

                        <!-- 4) 保留全部字段名：@Resource 按字段名注入、@ConfigurationProperties 绑定、反射字段、JSON 字段 -->
                        <option>-keepclassmembers class com.bszn.** { *** *; }</option>

                        <!-- 5) 保留 getter/setter：Jackson / fastjson2 / hutool BeanUtil 序列化依赖 -->
                        <option>-keepclassmembers class com.bszn.** { *** get*(); *** is*(); *** set*(...); }</option>

                        <!-- 6) 保留 @Bean 方法名：bean 名由方法名决定，存在 @Resource(name=...) / getBean("...") / SpEL 引用 -->
                        <option><![CDATA[-keepclassmembers class com.bszn.** { @org.springframework.context.annotation.Bean <methods>; }]]></option>

                        <!-- 7) 自定义 SQL Provider：@SelectProvider(type=BaseProviderMethodResolver.class) 依赖同名方法 -->
                        <option>-keep class com.bszn.base.sql.** { *; }</option>

                        <!--
                            8) 保留方法/构造器参数名（MethodParameters 属性）。
                               项目继承 spring-boot-starter-parent，编译时带 -parameters，Spring 6.x 的
                               StandardReflectionParameterNameDiscoverer 正是靠这个属性取参数名。
                               不保留会导致按类型注入出现多候选时无法按参数名消歧，例如
                               SysUserServiceImpl 注入裸 RedisTemplate 时报：
                               "Parameter 5 of constructor ... required a single bean, but 2 were found:
                                redisTemplate / stringRedisTemplate"。
                        -->
                        <option>-keepattributes MethodParameters</option>
                        <option>-keepparameternames</option>
                    </options>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                    <testFailureIgnore>true</testFailureIgnore>
                </configuration>
            </plugin>
        </plugins>
    </build>

