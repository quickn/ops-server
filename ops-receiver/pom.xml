<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.cloud</groupId>
        <artifactId>ops-server</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>ops-receiver</artifactId>
    <description>监控数据采集接收服务（ops-receiver）</description>

    <properties>
        <pagehelper.version>6.1.0</pagehelper.version>
    </properties>

    <dependencies>
        <!-- 公共基础模块：通用基础设施 + 监控公共模型（ops-admin / ops-receiver 复用） -->
        <dependency>
            <groupId>com.cloud</groupId>
            <artifactId>ops-common</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- ========== 基础 ========== -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <!-- 仅编译期使用，不打进 lib -->
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 接收 agent 上报数据（@RabbitListener） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!-- ========== 数据层 ========== -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid-spring-boot-starter</artifactId>
            <version>${druid.version}</version>
        </dependency>

        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
            <version>${mysql.version}</version>
        </dependency>

        <!--
            分页插件：config/MybatisConf 与 sql/BaseProviderMethodResolver 直接使用
            com.github.pagehelper.PageHelper、com.github.pagehelper.StringUtil
        -->
        <dependency>
            <groupId>com.github.pagehelper</groupId>
            <artifactId>pagehelper</artifactId>
            <version>${pagehelper.version}</version>
        </dependency>

        <!-- ========== 工具 / 序列化 ========== -->
        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2</artifactId>
            <version>${fastjson.version}</version>
        </dependency>

        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>

        <!-- 告警邮件（util/msg/WarnMailUtil 使用 org.apache.commons.mail） -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-email</artifactId>
            <version>1.5</version>
        </dependency>

        <!-- 实体/SQL 注解：io.swagger.annotations.ApiModelProperty -->
        <dependency>
            <groupId>io.swagger</groupId>
            <artifactId>swagger-annotations</artifactId>
            <version>1.6.2</version>
        </dependency>

        <!--
            Nacos 配置中心客户端（已停用，勿直接恢复）
            ============================================================
            停用原因：
              com.alibaba.boot:nacos-config-spring-boot-starter:0.3.0-RC 内部依赖
              nacos-spring-context:2.1.0-RC，其 DefaultYamlConfigParse.createYaml() 使用
              snakeyaml 1.x 才有的 new SafeConstructor() 无参构造；
              而 Spring Boot 3.2+（本项目 3.5.13）引入的是 snakeyaml 2.4，
              SafeConstructor 只剩 SafeConstructor(LoaderOptions) 一个构造方法，
              于是启动阶段（EnvironmentPostProcessor）必然抛出：
                java.lang.NoSuchMethodError:
                org.yaml.snakeyaml.constructor.SafeConstructor: method 'void <init>()' not found
              该 starter 早已停止维护（官方 issue 被以 not planned 关闭），升级无法修复。

            影响范围：
              该依赖虽然声明在 ops-receiver，但会随 ops-receiver 传递到 ops-admin
              （见 ops-admin/pom.xml 对 ops-receiver 的依赖），会导致两个应用启动时都崩溃。

            为何可以直接停用：
              项目中没有使用任何 Nacos 配置中心能力（无 @NacosValue /
              @NacosPropertySource / @NacosConfigurationProperties / @NacosConfigListener），
              application.yml 中的配置项全部为本地配置，不依赖远程下发。

            若日后确实需要 Nacos 配置中心，请改用 Spring Cloud Alibaba 方案：
              com.alibaba.cloud:spring-cloud-starter-alibaba-nacos-config
              + spring-cloud-alibaba-dependencies BOM
              + spring.config.import=nacos:<dataId>.yaml
            不要在 Spring Boot 3.2+ 下重新启用下面这个 starter。
        -->
        <!--
        <dependency>
            <groupId>com.alibaba.boot</groupId>
            <artifactId>nacos-config-spring-boot-starter</artifactId>
            <version>${nacos-config-spring-boot.version}</version>
        </dependency>
        -->

        <!--
            仅保留 nacos-client：
            controller/AgentController 使用了 com.alibaba.nacos.api.model.v2.Result
            （该类位于 nacos-client 中），需保留该依赖；
            同时显式指定版本，覆盖其它组件传递进来的旧版本。
            注意：nacos-client 不含任何 Spring 自动装配，不会触发配置中心的启动逻辑。
        -->
<!--        <dependency>
            <groupId>com.alibaba.nacos</groupId>
            <artifactId>nacos-client</artifactId>
            <version>2.3.2</version>
        </dependency>-->

        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
            <version>${knife4j.version}</version>
        </dependency>

    </dependencies>

