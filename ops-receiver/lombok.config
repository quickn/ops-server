# Lombok 配置（仅作用于 ops-receiver 模块）
config.stopBubbling = true

# @Data 生成的 equals/hashCode 是否调用 super：
#   call - 调用 super，父类字段（BaseEntity 的 id / serviceId / createTime）参与相等比较
#   skip - 不调用 super 且不告警（Lombok 默认行为，仅消除告警）
#   warn - 不调用 super 并告警（Lombok 默认值）
# 本模块实体均继承含公共字段的 BaseEntity，故显式选择 call，消除
# "Generating equals/hashCode implementation but without a call to superclass" 告警
lombok.equalsAndHashCode.callSuper = call
